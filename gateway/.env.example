# First pilot: accessible workbench only; no roof release yet.
GATEWAY_IMAGE="ghcr.io/erik-metz/hack-the-ried-gateway:pilot"
# Replace with the gateway's permanent 64-bit identity before starting.
GATEWAY_EUI=
# Raw single-line gateway LNS API key. Keep the real .env local (chmod 600).
TC_KEY=
TC_URI="wss://eu1.cloud.thethings.network:8887"
# BCM GPIO17 is a hypothesis until verified on the actual HAT.
# Dieser HAT wurde mit GPIO25 geprüft; reguläre RAK2287-HATs können GPIO17 nutzen.
RESET_GPIO="25"
GPIO_CHIP="gpiochip0"
# Gross antenna gain: 3 dBi, conservatively without subtracting unknown losses.
ANTENNA_GAIN_DBI="3"
