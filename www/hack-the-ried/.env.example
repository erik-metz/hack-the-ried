# HackTheRied - Next.js Environment Variables

# 1. Admin Control Panel Password
# Password used by administrators to log into the /admin dashboard
ADMIN_PASSWORD=YourSuperSecureAdminPassword2026!

# 2. VPS Telemetry Backend URL
# In local development: http://localhost:8080 for a locally started API
# In production: https://hack-the-ried.duckdns.org
BACKEND_API_URL=http://localhost:8080

# 3. VPS Backend Admin API Key
# Matches ADMIN_API_KEY set on the VPS FastAPI service
BACKEND_ADMIN_API_KEY=hack_the_ried_admin_replace_with_random_key

# Independent session signing secret. Generate with: openssl rand -hex 32
# Required in every environment; use a separate value for development.
# Rotating this value invalidates all existing admin sessions.
ADMIN_SESSION_SECRET=

# 4. Set this to the same random 32-byte value on every Next.js instance.
# Required when deploying multiple instances behind a load balancer so Server
# Actions created by one instance can be invoked on another.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-random-base64-encoded-32-byte-key
