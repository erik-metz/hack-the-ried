# Database Credentials
POSTGRES_DB=mydatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretSecurePassword123!

# App Configuration
API_PORT=8080

# Ingestion key for authenticated sensor and collector APIs
API_KEY=hack-the-ried-live-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API Key for sensor management (Next.js Admin Panel)
ADMIN_API_KEY=hack-the-ried-admin-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# The Things Stack webhook (set all three values before enabling the TTN webhook)
TTN_APPLICATION_ID=
TTN_WEBHOOK_USERNAME=
TTN_WEBHOOK_PASSWORD=

# Raspberry Shake multi-station collector
# Station metadata and channels are discovered automatically.
SHAKE_STATIONS=R498E,R82E7,R79F9,RB012,R021A,R5DFB,RC017,R2852,RB8D1,SC342
SHAKE_NETWORK=AM
SHAKE_WS_URL=wss://swarm:ujHsN9qbYiTAx69H@data.raspberryshake.org/caps/
SHAKE_INGEST_MODE=api
SHAKE_SAMPLING_INTERVAL_SEC=5.0
SHAKE_STORE_RAW_WAVEFORM=false

# Smart City overview collector (individual observations, no traffic/history aggregates)
SMARTCITY_TENANT=buerstadt
SMARTCITY_DASHBOARD_ID=76a90123-ba53-4d77-be9f-f11ef90dd63a
SMARTCITY_POLL_SECONDS=60
# Optional exact entity URNs and normalized metric names, comma-separated.
# Empty filters collect all supported measurements on this dashboard.
SMARTCITY_ENTITY_IDS=
SMARTCITY_METRICS=

# Optional monthly data archives (VPS archive-worker only)
# After CI publishes the image: docker compose --profile archives pull archive-worker
# Enable with: docker compose --profile archives up -d archive-worker
# Token from a dedicated UploadThing app; enable "Allow Overriding ACL" there.
# Keep this token on the VPS; never expose it in NEXT_PUBLIC_* variables.
UPLOADTHING_TOKEN=

# Maximum CSV size per ZIP part in MiB (1-256; metadata adds some overhead).
# All readings are exported across as many parts as needed.
ARCHIVE_PART_MB=64

# Server-only AISstream key for ship positions.
AIS_STREAM_API_KEY=
RHINE_MAP_PROVIDER=

# Public ADS-B aircraft collection; no API key required. Minimum 10 seconds.
AIRCRAFT_POLL_SECONDS=15

# Optional Space-Track integration: docker compose --profile satellites up -d
# Set these on the server only; never commit real credentials.
SPACE_TRACK_IDENTITY=
SPACE_TRACK_PASSWORD=
SATELLITE_NORAD_IDS=all

# Optional verified RIS journey/GTFS trip-instance crosswalk inside the worker.
# Store the version-1 JSON file on the persistent /data volume; empty means no joins.
RIS_TRIP_CROSSWALK_FILE=

# Regional fuel prices (server-only secret)
TANKERKOENIG_API_KEY=
FUEL_LATITUDE=49.62
FUEL_LONGITUDE=8.46
FUEL_RADIUS_KM=25
FUEL_POLL_SECONDS=300
