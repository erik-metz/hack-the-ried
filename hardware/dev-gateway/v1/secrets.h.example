#pragma once

// ===================== WiFi =====================
#define WIFI_SSID_1         "your-primary-wifi-ssid"
#define WIFI_PASSWORD_1     "your-primary-wifi-password"
#define WIFI_SSID_2         "your-fallback-hotspot-ssid"
#define WIFI_PASSWORD_2     "your-fallback-hotspot-password"

// ===================== Gateway identity =====================
// 16 hex characters (no 0x, no spaces). Leave empty "" to auto-generate from MAC.
#define GATEWAY_EUI         ""          // e.g. "AABBCCDDEEFF0011"

// ===================== TTN / LNS =====================
// TTN public (choose the correct regional router) or your private stack
// Register this exact EUI in TTN and do not enable "Require authenticated connection":
// the Semtech UDP protocol used by this development gateway has no authentication.
#define LNS_HOST            "eu1.cloud.thethings.network"   // or "nam1...", "au1...", or your private IP/hostname
#define LNS_PORT            1700

// ===================== Radio (change to your region) =====================
// This sketch is intentionally single-channel/single-data-rate. These values
// must match the uplink and downlink used by the development node under test.
#define LORA_FREQUENCY      868.1       // MHz  (EU868 default join channel)
#define LORA_SF             7           // Spreading Factor (7-12)
#define LORA_BW             125.0       // kHz
#define LORA_CR             5           // Coding rate 4/5 = 5
#define LORA_PREAMBLE       8
#define LORA_SYNC_WORD      0x34        // LoRaWAN public network
#define LORA_POWER          14          // dBm (keep reasonable; V4 can do more but respect regulations)
