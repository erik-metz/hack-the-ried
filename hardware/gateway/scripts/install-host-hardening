#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run with sudo' >&2; exit 1; }
root=$(cd "$(dirname "$0")/.." && pwd)
install -d -m 755 /usr/local/lib/kamue-gateway
install -d -m 700 /usr/local/lib/kamue-gateway/host
install -m 600 "$root"/host/* /usr/local/lib/kamue-gateway/host/
exec /usr/bin/python3 -I /usr/local/lib/kamue-gateway/host/harden.py apply --user "${1:-alpha}"
