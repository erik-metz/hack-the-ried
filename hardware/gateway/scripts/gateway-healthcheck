#!/usr/bin/env bash
# Local radio/bridge readiness. External LNS outages do not cause reboot loops.
set -euo pipefail
exec python3 - <<'PY'
import json, os, time
from pathlib import Path
d = json.loads(Path('/var/lib/kamue-gateway/health.json').read_text())
assert time.time()-d['at'] < 20 and d['radio_ready'] and d['station_connected']
assert Path('/proc',str(d['station_pid']),'exe').resolve() == Path('/app/artifacts/corecell/station')
os.kill(d['station_pid'],0)
PY
