#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run with sudo' >&2; exit 1; }
root=$(cd "$(dirname "$0")/.." && pwd)
install -d -m 755 /usr/local/lib/kamue-gateway
install -d -m 700 /usr/local/lib/kamue-gateway/network
install -m 600 "$root/network/fallback.py" /usr/local/lib/kamue-gateway/network/fallback.py
exec /usr/bin/python3 -I /usr/local/lib/kamue-gateway/network/fallback.py apply --env "${1:-$root/profiles/kamue.env}"
