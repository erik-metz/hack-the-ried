[Unit]
Description=Kamue gateway telemetry and durable HTTPS outbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/kamue-gateway/collector.py
Restart=on-failure
RestartSec=10
UMask=0077
StateDirectory=kamue-gateway-telemetry
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/kamue-gateway-telemetry

[Install]
WantedBy=multi-user.target
